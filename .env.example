# Copy this file to .env and fill in the values. .env is gitignored; never commit it.
#   cp .env.example .env

# --- LLM providers (API keys, not chat subscriptions) ---
# Anthropic: https://console.anthropic.com -> API Keys
ANTHROPIC_API_KEY=
# OpenAI: https://platform.openai.com -> API keys
OPENAI_API_KEY=

# Model per agent role, as "provider:model" (provider is anthropic or openai).
# Claude defaults retained for existing team setups; both providers are implemented.
# With both keys available, move the verifier to the other provider from
# the analyst so the check is independent (PRD v2 §5.4).
MIRA_MODEL_PLANNER=anthropic:claude-opus-5-5
MIRA_MODEL_SCOUT=anthropic:claude-sonnet-5-5
MIRA_MODEL_ANALYST=anthropic:claude-opus-5-5
MIRA_MODEL_VERIFIER=anthropic:claude-opus-5-5
MIRA_MODEL_WRITER=anthropic:claude-sonnet-5-5

# OpenAI-only alternative (replace the five settings above; do not append duplicates):
# MIRA_MODEL_PLANNER=openai:gpt-5.4
# MIRA_MODEL_SCOUT=openai:gpt-5.4-mini
# MIRA_MODEL_ANALYST=openai:gpt-5.4
# MIRA_MODEL_VERIFIER=openai:gpt-5.4
# MIRA_MODEL_WRITER=openai:gpt-5.4-mini
# This keeps separate verifier context, but is not cross-provider verification.

# Per-run budget defaults (PRD v2 §6.2). 300000 tokens is the development cap; raise it for evaluation runs.
MIRA_MAX_FETCHED_DOCUMENTS=60
MIRA_MAX_LLM_TOKENS=300000
MIRA_MAX_RUN_MINUTES=15
MIRA_MAX_GAP_ROUNDS=2

# --- Supabase (local stack; get values from `supabase status`) ---
SUPABASE_URL=http://127.0.0.1:55421
SUPABASE_ANON_KEY=
# Optional UI workspace (membership and row-level security still apply).
MIRA_WORKSPACE_SLUG=mira

# Worker only: direct Postgres connection with elevated rights. Server-side only;
# never expose to Streamlit or the browser.
MIRA_WORKER_DATABASE_URL=postgresql://postgres:postgres@127.0.0.1:55432/postgres

# Local development login, created against the local Supabase stack only (see README).
MIRA_DEV_EMAIL=
MIRA_DEV_PASSWORD=

# Optional ingestion expansion. Both adapters stay disabled unless explicitly enabled.
# Exa is paid discovery; enabling requires a separately authorized run budget.
MIRA_ENABLE_EXA_DISCOVERY=0
EXA_API_KEY=
# Offline Chromium capture also requires source connector_config.allow_browser=true.
# Install the optional browser extra and matching Chromium; no login or network navigation.
MIRA_ENABLE_OFFLINE_BROWSER=0
MIRA_BROWSER_EXECUTABLE=

# Actual network browser: separately source-approved, fresh sessions, public reads only.
MIRA_ENABLE_LIVE_BROWSER=0

# Normal-worker passage analysis. Full saved passages are never silently truncated.
MIRA_ANALYSIS_MAX_PASSAGES=12
MIRA_ANALYSIS_MAX_CHARACTERS=18000
MIRA_ANALYSIS_MAX_BATCHES=8
MIRA_ANALYSIS_MAX_OUTPUT_TOKENS=16384
MIRA_ANALYSIS_TIMEOUT_SECONDS=120
MIRA_ANALYSIS_RESERVE_TOKENS=32000
MIRA_ANALYSIS_RESERVE_SECONDS=120

# Private original bytes require BOTH this opt-in and an explicit source retention approval/reference.
# No catalog grant is added automatically. Browser DOM is not a publisher original.
MIRA_RETAIN_ORIGINALS=0
MIRA_ORIGINALS_DIR=
MIRA_ORIGINAL_MAX_BYTES=20000000

# Optional embeddings use the existing OpenAI credential. Enable only with an authorized run budget.
# Recommended 384-dimensional profile; this revision is our cache version, not a provider snapshot.
# Bump the revision when rebuilding embeddings after a model/profile change. Role models are separate.
MIRA_ENABLE_HYBRID_RETRIEVAL=0
MIRA_EMBEDDING_MODEL=text-embedding-3-small
MIRA_EMBEDDING_REVISION=mira-te3-small-384-v1
MIRA_EMBEDDING_DIMENSIONS=384
MIRA_HYBRID_MAX_PASSAGES=40
MIRA_HYBRID_MAX_CHARACTERS=60000
MIRA_HYBRID_MAX_TOKENS=20000
MIRA_HYBRID_TIMEOUT_SECONDS=20
MIRA_HYBRID_RESULT_LIMIT=20

# Optional private Supabase copies of reports and permitted originals.
# The signed-in app keeps using its anon/session credentials. This upload key is worker-only.
MIRA_ARTIFACT_STORAGE=local
MIRA_STORAGE_SERVICE_ROLE_KEY=
